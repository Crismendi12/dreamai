# DreamAI environment example. Copy to `.env.local` and fill in as needed.

# --- Demo / mock fallback (frontend) -------------------------------------
# Controls whether the UI uses the real backend or built-in mock demo data.
# The request/response contract is identical in every mode, so wiring the
# real backend needs no component changes.
#
#   true   -> always use mock data (snappy click-through demo, no network)
#   false  -> always use the real backend, no fallback   ← SET THIS IN PRODUCTION
#   (unset / auto) -> try the real backend, gracefully fall back to mock on failure (default)
#
# For sharing a clickable demo with the team, leave it unset (auto) or set "true".
NEXT_PUBLIC_DEMO_MODE=auto

# --- Backend credentials (server-side; used by /api/* when NOT mocking) ---
# fal.ai (Whisper transcription + Kling video generation)
FAL_KEY=
# Anthropic (Claude analysis / follow-up / rescripting)
ANTHROPIC_API_KEY=
